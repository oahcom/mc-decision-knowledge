{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MC Decision Knowledge Item",
  "version": "2026-11-01.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "knowledge_type",
    "title",
    "summary",
    "game_edition",
    "game_versions",
    "stage",
    "trigger",
    "actions",
    "preconditions",
    "success_condition",
    "abort_condition",
    "risk_notes",
    "source_refs",
    "evidence_type",
    "confidence",
    "validation_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)+$",
      "description": "稳定唯一 ID，小写下划线，建议按类型加前缀。"
    },
    "knowledge_type": {
      "enum": [
        "strategy",
        "playbook",
        "failure_recovery",
        "tool_guide",
        "ai_heuristic"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 800
    },
    "game_edition": {
      "enum": [
        "java",
        "bedrock",
        "both"
      ]
    },
    "game_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stage": {
      "enum": [
        "spawn",
        "wood_age",
        "stone_age",
        "iron_age",
        "diamond_age",
        "nether",
        "end",
        "general"
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "state_features"
      ],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "state_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_condition": {
      "type": "string",
      "minLength": 5
    },
    "abort_condition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_type": {
      "enum": [
        "official_document",
        "code_behavior",
        "community_consensus",
        "expert_heuristic",
        "replay_observation",
        "ai_synthesis"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "信任等级：由 scripts/grade_confidence.py 按「证据强度 × 评审进度闸门」推导，不得手工填写。项目策略（project.json 的 allowed_high_confidence_only_after = replay_verified）规定：validation_status 未达到 replay_verified / human_verified 时，confidence 最高只能是 medium。想看纯粹由来源构成决定的证据强度，请读 evidence_strength。"
    },
    "validation_status": {
      "enum": [
        "draft",
        "source_verified",
        "replay_verified",
        "human_verified",
        "deprecated"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tunable_thresholds": {
      "type": "array",
      "description": "作者自定的策略阈值声明。条目里的每个数字只有两种合法来源：(1) 机制事实——必须能被所引来源的摘录或其可验证推导支撑；(2) 可调阈值——不对应任何外部事实，因此必须在这里显式声明，否则下游无法区分「机制如此」与「作者如此决定」。每条声明给出所在字段、字面值、原文片段与理由。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "context",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 2,
            "description": "该数字出现在条目的哪个字段（顶层键名）。"
          },
          "value": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
            "description": "阈值的字面值。"
          },
          "context": {
            "type": "string",
            "minLength": 4,
            "description": "该数字在字段中出现的原文片段，用于把同一数字的不同含义区分开。"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "为什么这是作者自定阈值而不是机制事实。"
          }
        }
      }
    },
    "candidate_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenario": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continue_condition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_condition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_entry_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "possible_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recovery_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalate_after": {
      "type": "integer",
      "minimum": 1
    },
    "escalation_unit": {
      "enum": [
        "recovery_round",
        "attempt"
      ],
      "description": "escalate_after 的计数单位：recovery_round 表示一次完整的 L1→L3 恢复轮次，attempt 表示单次工具调用。"
    },
    "verified_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "api_contract",
          "error_codes",
          "default_values",
          "gameplay_mechanics",
          "project_policy"
        ]
      },
      "description": "validation_status 为 source_verified 时必填：记录实际核对过的范围。"
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_name": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "boolean_or_ignore",
              "object",
              "block_pos",
              "entity_ref",
              "item_id",
              "list<string>",
              "map"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "expected_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_rule": {
      "type": "string"
    },
    "alternative_comparison": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_guidance": {
      "type": "string"
    },
    "evidence_strength": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "证据强度：纯由来源构成推导（official_document / code_behavior 支撑为 high，社区与论文综合为 medium，依赖内部设计且无交叉验证为 low）。与 confidence（信任等级，受评审进度闸门约束）正交。评分规则见 scripts/grade_confidence.py。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "knowledge_type": {
            "const": "strategy"
          }
        }
      },
      "then": {
        "required": [
          "candidate_routes",
          "decision_tradeoffs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "knowledge_type": {
            "const": "playbook"
          }
        }
      },
      "then": {
        "required": [
          "scenario",
          "checklist",
          "continue_condition",
          "exit_condition",
          "failure_entry_points"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "knowledge_type": {
            "const": "failure_recovery"
          }
        }
      },
      "then": {
        "required": [
          "symptoms",
          "possible_causes",
          "diagnostics",
          "recovery_steps",
          "escalate_after",
          "escalation_unit",
          "forbidden_actions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "source_verified"
          }
        }
      },
      "then": {
        "required": [
          "verified_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "knowledge_type": {
            "const": "tool_guide"
          }
        }
      },
      "then": {
        "required": [
          "tool_name",
          "parameters",
          "expected_effects",
          "failure_modes",
          "verification"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "knowledge_type": {
            "const": "ai_heuristic"
          }
        }
      },
      "then": {
        "required": [
          "decision_rule",
          "alternative_comparison",
          "anti_patterns",
          "model_guidance"
        ]
      }
    }
  ]
}
